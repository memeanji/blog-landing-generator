# Copy this file to .env and fill values locally.
# Keep ENABLE_EXTERNAL_ACTIONS=false until you are ready to touch Google Sheets or browser automation.

ENABLE_EXTERNAL_ACTIONS=false

GOOGLE_SERVICE_ACCOUNT_JSON=C:\path\to\service-account.json
REFERENCE_SPREADSHEET_ID=

NAVER_BLOG_HOME_URL=https://blog.naver.com/MyBlog.naver
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_USER_DATA_DIR=playwright-profile

# ── Streamlit Community Cloud 로 올릴 때 ─────────────────────────
#   파일을 둘 수 없으므로 Secrets 에 **JSON 내용 자체**를 넣는다.
#   (GOOGLE_SERVICE_ACCOUNT_JSON 경로 대신 이 값을 쓴다)
# GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT={"type":"service_account", ... }
#
#   브랜드 설정을 저장소에 두고 싶지 않으면 brands.json 내용을 통째로 넣을 수 있다.
# BLOG_BRANDS_JSON={"brands":[ ... ]}
