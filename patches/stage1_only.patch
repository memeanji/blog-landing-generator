+            rec = store.find_by_client_key(client_key)
+        except NotImplementedError:
+            return None, "이 저장소는 작업 조회를 지원하지 않습니다"
+        except Exception as exc:                               # noqa: BLE001
+            why = f"{type(exc).__name__}: {exc}"
+            continue
+        if rec:
+            return rec, ""
+        why = ""
+    return None, why
