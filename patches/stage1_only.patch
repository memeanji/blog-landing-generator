+    """
+    if getattr(exc, "definite_failure", False):
+        return True
+    if isinstance(exc, (TypeError, ValueError, KeyError)):
+        return True                        # 우리 쪽 인자 오류 = 보내기 전에 막혔다
+    # 로컬 파일 큐는 네트워크가 없다 → 실패했으면 파일도 없다(조회가 정확하다)
+    return bool(getattr(store, "is_local", False))
+
+
